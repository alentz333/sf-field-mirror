{
  "manifest_version": 3,
  "name": "Field Mirror for Salesforce",
  "version": "1.0.0",
  "description": "Create a custom field once and mirror it across Lead, Contact, Opportunity, Case, and Account.",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.force.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Field Mirror for Salesforce",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
