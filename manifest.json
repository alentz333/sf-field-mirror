{
  "manifest_version": 3,
  "name": "Field Mirror for Salesforce",
  "version": "1.0.0",
  "description": "Create a custom field once and mirror it across Lead, Contact, Opportunity, Case, and Account.",
  "author": "Alex Lentz",
  "homepage_url": "https://github.com/alentz333/sf-field-mirror",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.lightning.force.com/*"
  ],
  "minimum_chrome_version": "103",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Field Mirror for Salesforce",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
